# Copy this file to .env and fill in your values
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
# Get a free Groq API key at: https://console.groq.com (14,400 req/day free)

GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: Run Workflow button in the UI (dispatches the GitHub Actions workflow)
# Fine-grained token for the BrandSCOPE repo: Contents Read and write, Actions Read and write
GITHUB_TOKEN=
GITHUB_REPO=SupratikB23/BrandSCOPE
